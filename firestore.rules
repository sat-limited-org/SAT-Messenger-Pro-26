rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation schemas
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500000)) &&
             (!('statusMessage' in data) || data.statusMessage == null || (data.statusMessage is string && data.statusMessage.size() <= 200)) &&
             (!('isOnline' in data) || data.isOnline is bool) &&
             (!('lastSeen' in data) || data.lastSeen == null || data.lastSeen is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidPrivacySettings(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.readReceipts is bool &&
             data.lastSeenVisible is bool &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidBlockedUser(data) {
      return data.blockedUserId is string && data.blockedUserId.size() <= 128 &&
             (!('blockedUserName' in data) || data.blockedUserName == null || (data.blockedUserName is string && data.blockedUserName.size() <= 100)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidChat(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.type in ['direct', 'group'] &&
             (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 100)) &&
             data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 100 &&
             (!('adminIds' in data) || data.adminIds == null || (data.adminIds is list && data.adminIds.size() <= 20)) &&
             (!('lastMessageText' in data) || data.lastMessageText == null || (data.lastMessageText is string && data.lastMessageText.size() <= 5000)) &&
             (!('lastSenderId' in data) || data.lastSenderId == null || (data.lastSenderId is string && data.lastSenderId.size() <= 128)) &&
             (!('lastSenderName' in data) || data.lastSenderName == null || (data.lastSenderName is string && data.lastSenderName.size() <= 100)) &&
             (!('isTyping' in data) || data.isTyping == null || data.isTyping is map || data.isTyping is bool) &&
             (!('lastTimestamp' in data) || data.lastTimestamp == null || data.lastTimestamp is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.chatId is string && data.chatId.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.text is string && data.text.size() <= 10000 &&
             data.memberIds is list && data.memberIds.size() <= 100 &&
             (!('type' in data) || data.type in ['text', 'image', 'file']) &&
             (!('attachmentUrl' in data) || data.attachmentUrl == null || (data.attachmentUrl is string && data.attachmentUrl.size() <= 500000)) &&
             (!('replyToId' in data) || data.replyToId == null || (data.replyToId is string && data.replyToId.size() <= 128)) &&
             (!('replyToText' in data) || data.replyToText == null || (data.replyToText is string && data.replyToText.size() <= 500)) &&
             (!('replyToSender' in data) || data.replyToSender == null || (data.replyToSender is string && data.replyToSender.size() <= 100)) &&
             (!('status' in data) || data.status in ['sent', 'delivered', 'read']) &&
             (!('readBy' in data) || data.readBy == null || data.readBy is map || (data.readBy is list && data.readBy.size() <= 100)) &&
             (!('deleted' in data) || data.deleted is bool);
    }

    function isValidReport(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.reporterId is string && data.reporterId.size() <= 128 &&
             data.reportedUserId is string && data.reportedUserId.size() <= 128 &&
             data.reason is string && data.reason.size() <= 200 &&
             (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 2000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 1. Users collection
    match /users/{userId} {
      allow get, list: if isSignedIn() && isValidId(userId);

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming());

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId;

      // Settings subcollection
      match /settings/{settingId} {
        allow read, write: if isSignedIn() &&
                              isValidId(userId) &&
                              request.auth.uid == userId;
      }

      // Blocked users subcollection
      match /blocked/{blockedId} {
        allow read, write: if isSignedIn() &&
                              isValidId(userId) &&
                              request.auth.uid == userId;
      }
    }

    // 2. Chats collection
    match /chats/{chatId} {
      allow get: if isSignedIn() &&
                    isValidId(chatId) &&
                    request.auth.uid in resource.data.memberIds;

      allow list: if isSignedIn() &&
                     request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn() &&
                       isValidId(chatId) &&
                       request.auth.uid in incoming().memberIds &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidChat(incoming());

      allow update: if isSignedIn() &&
                       isValidId(chatId) &&
                       request.auth.uid in existing().memberIds &&
                       request.auth.uid in incoming().memberIds &&
                       incoming().createdAt == existing().createdAt &&
                       isValidChat(incoming());

      allow delete: if isSignedIn() &&
                       isValidId(chatId) &&
                       request.auth.uid in existing().memberIds;

      // Messages subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
                      isValidId(chatId) &&
                      isValidId(messageId) &&
                      request.auth.uid in resource.data.memberIds;

        allow list: if isSignedIn() &&
                       isValidId(chatId) &&
                       request.auth.uid in resource.data.memberIds;

        allow create: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         request.auth.uid == incoming().senderId &&
                         request.auth.uid in incoming().memberIds &&
                         incoming().chatId == chatId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidMessage(incoming());

        allow update: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         request.auth.uid in existing().memberIds &&
                         incoming().senderId == existing().senderId &&
                         incoming().chatId == existing().chatId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidMessage(incoming());

        allow delete: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         request.auth.uid == existing().senderId;
      }
    }

    // 3. Reports collection
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidReport(incoming());

      allow read, update, delete: if false;
    }
  }
}
